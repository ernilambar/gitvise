{
	"name": "nilambar/gitvise",
	"description": "WordPress plugin updater from GitHub releases",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"autoload": {
		"psr-4": {
			"Nilambar\\Gitvise\\": "src/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0 || ^10.0",
		"squizlabs/php_codesniffer": "^3.0",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"phpcs": "phpcs"
	}
}
