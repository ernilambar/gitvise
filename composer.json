{
	"name": "ernilambar/gitvise",
	"description": "WordPress plugin updater from GitHub releases",
	"license": "MIT",
	"type": "library",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0 || ^10.0",
		"squizlabs/php_codesniffer": "^3.0",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Nilambar\\Gitvise\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"format": "@php ./vendor/bin/phpcbf --report-full --report-summary .",
		"lint": "@php ./vendor/bin/phpcs --report-full --report-summary .",
		"test": "phpunit"
	}
}
